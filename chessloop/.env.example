# Public port the web UI listens on (nginx → http://localhost:${PUBLIC_PORT}).
PUBLIC_PORT=8090

# JWT signing secret. Generate one with: openssl rand -base64 32
JWT_SECRET=replace-with-openssl-rand-base64-32

# CORS origins. For testing: use "*" to allow all origins (localhost, Tailscale funnel, etc)
# For production: specify explicit origins like "https://example.com,http://localhost:8090"
# CORS_ORIGINS=*
