# ChessLoop settings. The installer (deploy.sh) writes this file for you as
# chessloop/.env. To set it up by hand: copy this file to .env, change what you
# need, then run  docker compose -f docker-compose.prod.yml up -d
# After any change, run that same command again so ChessLoop picks it up.
# Keep .env private (chmod 600 .env): it holds your secret and email password.
# A line that starts with # is a comment and is ignored.

# ── Required ─────────────────────────────────────────────────────────────────

# Secret key that protects everyone's sign-in. REQUIRED. Make one by running
#   openssl rand -base64 32
# and paste the output after the = sign. Don't type the command itself here:
# this file does not run commands. ChessLoop refuses to start with this example
# value or with anything shorter than 32 characters.
JWT_SECRET=replace-with-openssl-rand-base64-32

# ── Where ChessLoop listens (optional) ───────────────────────────────────────

# Port for the web page: http://localhost:8090. Default 8090.
PUBLIC_PORT=8090

# Who can connect. 127.0.0.1 (default): only this computer, or a reverse proxy
# (Caddy, nginx) on it. 0.0.0.0: also other devices on your network.
# BIND_ADDR=127.0.0.1

# Your domain name, if ChessLoop is on the internet behind HTTPS, e.g.
# chess.example.com. Used for links in emails. Leave empty otherwise.
# DOMAIN=

# Web address people use to open ChessLoop, used for links in emails, e.g.
# http://192.168.1.20:8090 for a home network. Default: https://DOMAIN if
# DOMAIN is set, otherwise http://localhost:PUBLIC_PORT.
# FRONTEND_URL=

# Other web sites allowed to call ChessLoop's API from a browser, separated by
# commas. Leave empty: ChessLoop's own page doesn't need this. Never use *.
# CORS_ORIGINS=

# ── Email (optional) ─────────────────────────────────────────────────────────
# Without SMTP, ChessLoop sends no email: new accounts can log in at once and an
# admin verifies accounts or sets passwords in Admin → Users.

# Your mail provider's SMTP server, e.g. smtp.gmail.com. Empty: no email.
# SMTP_HOST=

# SMTP port. Default 587 (STARTTLS); use what your provider says.
# SMTP_PORT=587

# SMTP login name and password (for Gmail: your address and an app password).
# SMTP_USER=
# SMTP_PASSWORD=

# Sender shown on emails, e.g. ChessLoop <chess@example.com>. Default: your
# SMTP_USER if it is an email address. Many providers only accept their own.
# SMTP_FROM=

# Encrypt the connection with STARTTLS: true (default) or false.
# SMTP_USE_TLS=true

# Email verification for new accounts: auto (default; on only when SMTP_HOST is
# set), on, or off. An admin's choice in Admin → System settings overrides it.
# EMAIL_VERIFICATION=auto

# Check at registration that the email's domain can receive mail (a live DNS
# lookup): true or false (default). It fails on servers without internet DNS.
# EMAIL_MX_CHECK=false

# ── Advanced (optional) ──────────────────────────────────────────────────────

# Minutes a sign-in lasts before it is silently renewed (default 15), and days
# before you must sign in again (default 30).
# ACCESS_TTL_MIN=15
# REFRESH_TTL_DAYS=30

# Lichess API token. Optional; only needed to import extra variations from
# Lichess in the Admin panel. (Not used by this version yet.)
# LICHESS_API_TOKEN=
