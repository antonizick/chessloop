# Public port the web UI listens on (nginx → http://localhost:${PUBLIC_PORT}).
PUBLIC_PORT=8090

# JWT signing secret. Generate one with: openssl rand -base64 32
JWT_SECRET=replace-with-openssl-rand-base64-32

# CORS origins. For testing: use "*" to allow all origins (localhost, Tailscale funnel, etc)
# For production: specify explicit origins like "https://example.com,http://localhost:8090"
# CORS_ORIGINS=*

# ── Email (optional) ─────────────────────────────────────────────────────────
# Without SMTP, ChessLoop sends no email: new accounts can log in at once and an
# admin verifies accounts or sets passwords in Admin → Users.
# Note: docker-compose.prod.yml does not pass these keys to the app yet.

# Email verification for new accounts: auto (default; on only when SMTP_HOST is
# set), on, or off. An admin's choice in Admin → System settings overrides it.
# EMAIL_VERIFICATION=auto

# Check at registration that the email's domain can receive mail (a live DNS
# lookup). Off by default: it fails on servers without internet DNS.
# EMAIL_MX_CHECK=false
